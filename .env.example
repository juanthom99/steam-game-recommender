# Copy to .env and fill in. Never commit .env.

# Steam: titles, images and current prices come from the store endpoint, which needs NO key:
#   https://store.steampowered.com/api/appdetails?appids=<app_id>&cc=us
# A Web API key is only needed for user/profile endpoints. Get one at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# IsThereAnyDeal (required, returns 403 without it). Register an app at https://isthereanydeal.com/apps/my/
ITAD_API_KEY=

# Kaggle: not needed. The dataset downloads anonymously with kagglehub.
# Supabase (project pwcywpymbhnrixolvuvv). Service role key: Dashboard > Project Settings > API Keys. Keep secret.
SUPABASE_URL=https://pwcywpymbhnrixolvuvv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
